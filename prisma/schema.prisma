generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["views"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "mysql"
}

model absence {
  id                      String                 @id @default(uuid())
  dateDebut               DateTime
  dateFin                 DateTime
  motif                   String
  statut                  absence_statut
  commentaire             String?
  declareParUserId        String
  justificatifUrl         String?
  inscriptionApprenantId  String
  inscriptionAnneeId      String
  affectationEnseignantId String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @default(now())
  affectationenseignant   affectationenseignant? @relation(fields: [affectationEnseignantId], references: [id], onDelete: Cascade, map: "Absence_affectationEnseignantId_fkey")
  inscription             inscription            @relation(fields: [inscriptionApprenantId, inscriptionAnneeId], references: [apprenantId, anneeScolaireId], onDelete: Cascade, map: "Absence_inscriptionApprenantId_inscriptionAnneeId_fkey")

  @@index([affectationEnseignantId], map: "Absence_affectationEnseignantId_fkey")
  @@index([inscriptionApprenantId, inscriptionAnneeId], map: "Absence_inscriptionApprenantId_inscriptionAnneeId_idx")
}

model affectationenseignant {
  id               String          @id @default(uuid())
  employeId        String
  classeScolaireId String
  matiereId        String
  anneeScolaireId  String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now())
  absence          absence[]
  anneescolaire    anneescolaire   @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade, map: "AffectationEnseignant_anneeScolaireId_fkey")
  classscolaire    classscolaire   @relation(fields: [classeScolaireId], references: [id], onDelete: Cascade, map: "AffectationEnseignant_classeScolaireId_fkey")
  employe          employe         @relation(fields: [employeId], references: [id], onDelete: Cascade, map: "AffectationEnseignant_employeId_fkey")
  matiere          matiere         @relation(fields: [matiereId], references: [id], onDelete: Cascade, map: "AffectationEnseignant_matiereId_fkey")
  emploidutemps    emploidutemps[]
  evaluation       evaluation[]
  note             note[]

  @@unique([matiereId, classeScolaireId, anneeScolaireId], map: "AffectationEnseignant_matiereId_classeScolaireId_anneeScolai_key")
  @@index([anneeScolaireId], map: "AffectationEnseignant_anneeScolaireId_idx")
  @@index([classeScolaireId], map: "AffectationEnseignant_classeScolaireId_fkey")
  @@index([employeId], map: "AffectationEnseignant_employeId_idx")
}

model anneescolaire {
  id                     String                   @id @default(uuid())
  ecoleId                String
  nom                    String
  dateDebut              DateTime
  dateFin                DateTime
  statut                 anneescolaire_statut     @default(EN_PREPARATION)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now())
  affectationenseignant  affectationenseignant[]
  ecole                  ecole                    @relation(fields: [ecoleId], references: [id], map: "AnneeScolaire_ecoleId_fkey")
  configurationscolarite configurationscolarite[]
  inscription            inscription[]
  periodescolaire        periodescolaire[]
  politiqueevaluation    politiqueevaluation[]

  @@unique([nom, ecoleId], map: "AnneeScolaire_nom_ecoleId_key")
  @@index([ecoleId], map: "AnneeScolaire_ecoleId_idx")
}

model annonce {
  id             String         @id @default(uuid())
  titre          String
  contenu        String
  datePubication DateTime       @default(now())
  dateExpiration DateTime
  ecoleId        String
  auteurId       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())
  employe        employe        @relation(fields: [auteurId], references: [id], onDelete: Cascade, map: "Annonce_auteurId_fkey")
  ecole          ecole          @relation(fields: [ecoleId], references: [id], onDelete: Cascade, map: "Annonce_ecoleId_fkey")
  cibleannonce   cibleannonce[]

  @@index([auteurId], map: "Annonce_auteurId_fkey")
  @@index([ecoleId], map: "Annonce_ecoleId_idx")
}

model apprenant {
  id              String            @id @default(uuid())
  userId          String?           @unique(map: "Apprenant_userId_key")
  matricule       String            @unique(map: "Apprenant_matricule_key")
  nom             String
  prenoms         String
  Sexe            apprenant_Sexe
  dateNaissance   DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())
  user            user?             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Apprenant_userId_fkey")
  apprenantparent apprenantparent[]
  inscription     inscription[]

  @@index([matricule], map: "Apprenant_matricule_idx")
  @@index([userId], map: "Apprenant_userId_idx")
}

model apprenantparent {
  apprenantId String
  parentId    String
  lien        apprenantparent_lien
  apprenant   apprenant            @relation(fields: [apprenantId], references: [id], onDelete: Cascade, map: "ApprenantParent_apprenantId_fkey")
  parent      parent               @relation(fields: [parentId], references: [id], onDelete: Cascade, map: "ApprenantParent_parentId_fkey")

  @@id([apprenantId, parentId])
  @@index([parentId], map: "ApprenantParent_parentId_idx")
}

model bulletin {
  moyenneGenerale        Float
  documentUrl            String
  Rang                   Int?
  estGenere              Boolean                   @default(false)
  dateGeneration         DateTime?
  appreciation           String?
  decisionFinAnnee       bulletin_decisionFinAnnee
  inscriptionApprenantId String
  inscriptionAnneeId     String
  periodeScolaireId      String
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @default(now())
  inscription            inscription               @relation(fields: [inscriptionApprenantId, inscriptionAnneeId], references: [apprenantId, anneeScolaireId], onDelete: Cascade, map: "Bulletin_inscriptionApprenantId_inscriptionAnneeId_fkey")
  periodescolaire        periodescolaire           @relation(fields: [periodeScolaireId], references: [id], onDelete: Cascade, map: "Bulletin_periodeScolaireId_fkey")
  lignebulletin          lignebulletin[]

  @@id([inscriptionApprenantId, inscriptionAnneeId, periodeScolaireId])
  @@index([periodeScolaireId], map: "Bulletin_periodeScolaireId_idx")
}

model cibleannonce {
  id               String              @id @default(uuid())
  public           cibleannonce_public
  annonceId        String
  classeScolaireId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now())
  annonce          annonce             @relation(fields: [annonceId], references: [id], onDelete: Cascade, map: "CibleAnnonce_annonceId_fkey")

  @@index([annonceId], map: "CibleAnnonce_annonceId_idx")
}

model classematirere {
  id                  String             @id @default(uuid())
  classeScolaireId    String
  matiereId           String
  uniteEnseignementId String?
  coefficient         Int
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now())
  classscolaire       classscolaire      @relation(fields: [classeScolaireId], references: [id], onDelete: Cascade, map: "ClasseMatirere_classeScolaireId_fkey")
  matiere             matiere            @relation(fields: [matiereId], references: [id], onDelete: Cascade, map: "ClasseMatirere_matiereId_fkey")
  uniteenseignement   uniteenseignement? @relation(fields: [uniteEnseignementId], references: [id], map: "ClasseMatirere_uniteEnseignementId_fkey")

  @@unique([classeScolaireId, matiereId], map: "ClasseMatirere_classeScolaireId_matiereId_key")
  @@index([classeScolaireId], map: "ClasseMatirere_classeScolaireId_idx")
  @@index([matiereId], map: "ClasseMatirere_matiereId_fkey")
  @@index([uniteEnseignementId], map: "ClasseMatirere_uniteEnseignementId_fkey")
}

model classscolaire {
  id                    String                  @id @default(uuid())
  niveauScolaireId      String
  nom                   String
  capacite              Int
  emploiDuTempsId       String                  @unique(map: "ClassScolaire_emploiDuTempsId_key")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now())
  affectationenseignant affectationenseignant[]
  classematirere        classematirere[]
  emploidutemps         emploidutemps           @relation(fields: [emploiDuTempsId], references: [id], onDelete: Cascade, map: "ClassScolaire_emploiDuTempsId_fkey")
  niveauscolaire        niveauscolaire          @relation(fields: [niveauScolaireId], references: [id], onDelete: Cascade, map: "ClassScolaire_niveauScolaireId_fkey")
  inscription           inscription[]
  politiqueevaluation   politiqueevaluation?

  @@unique([niveauScolaireId, nom], map: "ClassScolaire_niveauScolaireId_nom_key")
  @@index([niveauScolaireId], map: "ClassScolaire_niveauScolaireId_idx")
}

model configurationscolarite {
  id               String             @id @default(uuid())
  nom              String
  estActive        Boolean            @default(true)
  ecoleId          String
  niveauScolaireId String
  anneeScolaireId  String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now())
  anneescolaire    anneescolaire      @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade, map: "ConfigurationScolarite_anneeScolaireId_fkey")
  ecole            ecole              @relation(fields: [ecoleId], references: [id], onDelete: Cascade, map: "ConfigurationScolarite_ecoleId_fkey")
  niveauscolaire   niveauscolaire     @relation(fields: [niveauScolaireId], references: [id], onDelete: Cascade, map: "ConfigurationScolarite_niveauScolaireId_fkey")
  dossierscolarite dossierscolarite[]
  inscription      inscription[]
  tranchescolarite tranchescolarite[]

  @@unique([niveauScolaireId, anneeScolaireId], map: "ConfigurationScolarite_niveauScolaireId_anneeScolaireId_key")
  @@index([anneeScolaireId], map: "ConfigurationScolarite_anneeScolaireId_fkey")
  @@index([ecoleId], map: "ConfigurationScolarite_ecoleId_fkey")
}

model conversation {
  id                      String                    @id @default(uuid())
  type                    conversation_type
  ecoleId                 String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now())
  ecole                   ecole                     @relation(fields: [ecoleId], references: [id], onDelete: Cascade, map: "Conversation_ecoleId_fkey")
  message                 message[]
  participantconversation participantconversation[]

  @@index([ecoleId], map: "Conversation_ecoleId_idx")
}

model decisionfinannee {
  id                     String                    @id @default(uuid())
  decision               decisionfinannee_decision
  inscriptionApprenantId String
  inscriptionAnneeId     String
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @default(now())
  inscription            inscription               @relation(fields: [inscriptionApprenantId, inscriptionAnneeId], references: [apprenantId, anneeScolaireId], onDelete: Cascade, map: "DecisionFinAnnee_inscriptionApprenantId_inscriptionAnneeId_fkey")

  @@unique([inscriptionApprenantId, inscriptionAnneeId], map: "DecisionFinAnnee_inscriptionApprenantId_inscriptionAnneeId_key")
}

model demandeecole {
  id                  String               @id @default(uuid())
  ecoleId             String?
  type                demande_ecole_type
  statut              demande_ecole_statut @default(EN_ATTENTE)

  nomPropose          String?
  typePropose         ecole_type?
  nomFondateurPropose String?
  villePropose        String?
  boitePostalePropose String?
  emailPropose        String?
  telephonePropose    String?
  descriptionPropose  String?              @db.Text

  motif               String?              @db.Text
  commentaireAdmin    String?              @db.Text
  demandeurId         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now())

  ecole               ecole?                @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  demandeur           user                 @relation(fields: [demandeurId], references: [clerkUserId], onDelete: Cascade)

  @@index([ecoleId])
  @@index([demandeurId])
}

model dossierscolarite {
  id                       String                  @id @default(uuid())
  montant                  Int
  resteAPayer              Int
  statut                   dossierscolarite_statut
  inscriptionApprenantId   String
  inscriptionAnneeId       String
  configurationScolariteId String
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @default(now())
  configurationscolarite   configurationscolarite  @relation(fields: [configurationScolariteId], references: [id], onDelete: Cascade, map: "DossierScolarite_configurationScolariteId_fkey")
  inscription              inscription             @relation(fields: [inscriptionApprenantId, inscriptionAnneeId], references: [apprenantId, anneeScolaireId], onDelete: Cascade, map: "DossierScolarite_inscriptionApprenantId_inscriptionAnneeId_fkey")
  paiement                 paiement[]

  @@unique([inscriptionApprenantId, inscriptionAnneeId], map: "DossierScolarite_inscriptionApprenantId_inscriptionAnneeId_key")
  @@index([configurationScolariteId], map: "DossierScolarite_configurationScolariteId_fkey")
  @@index([inscriptionApprenantId, inscriptionAnneeId], map: "DossierScolarite_inscriptionApprenantId_inscriptionAnneeId_idx")
}

model ecole {
  id                     String                   @id @default(uuid())
  nom                    String
  type                   ecole_type
  nomFondateur           String
  ville                  String
  boitePostale           String?                  @unique(map: "Ecole_boitePostale_key")
  email                  String                   @unique(map: "Ecole_email_key")
  telephone              String
  description            String?
  statut                 ecole_statut             @default(EN_ATTENTE)
  code                   String                   @unique(map: "Ecole_code_key")
  createdAt              DateTime                 @default(now())
  valideAt               DateTime?
  updatedAt              DateTime                 @default(now())
  createurId             String?
  createur               user?                     @relation("EcoleCreateur", fields: [createurId], references: [clerkUserId], onDelete:SetNull )
  anneescolaire          anneescolaire[]
  annonce                annonce[]
  configurationscolarite configurationscolarite[]
  conversation           conversation[]
  matiere                matiere[]
  niveauscolaire         niveauscolaire[]
  politiqueevaluation    politiqueevaluation[]
  role                   role[]
  typeevaluation         typeevaluation[]
  user                   user[]                   @relation("ecoletouser")
  demandes               demandeecole[]

  @@index([ville], map: "Ecole_ville_idx")
}

model emploidutemps {
  id                      String                        @id @default(uuid())
  affectationEnseignantId String
  jourDeLaSemaine         emploidutemps_jourDeLaSemaine
  heureDebut              String
  heureFin                String
  classeScolaireId        String
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @default(now())
  classscolaire           classscolaire?
  affectationenseignant   affectationenseignant         @relation(fields: [affectationEnseignantId], references: [id], onDelete: Cascade, map: "EmploiDuTemps_affectationEnseignantId_fkey")

  @@unique([affectationEnseignantId, jourDeLaSemaine, heureDebut], map: "EmploiDuTemps_affectationEnseignantId_jourDeLaSemaine_heureD_key")
}

model employe {
  id                    String                  @id @default(uuid())
  matricule             String                  @unique(map: "Employe_matricule_key")
  dateEmbauche          DateTime
  clerkUserId           String                  @unique(map: "Employe_clerkUserId_key")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now())
  affectationenseignant affectationenseignant[]
  annonce               annonce[]
  user                  user                    @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Cascade, map: "Employe_clerkUserId_fkey")
  employedocument       employedocument[]
  employerole           employerole[]
}

model employedocument {
  id          String               @id @default(uuid())
  employeId   String
  type        employedocument_type
  titre       String
  documentUrl String
  createdAt   DateTime             @default(now())
  employe     employe              @relation(fields: [employeId], references: [id], onDelete: Cascade, map: "EmployeDocument_employeId_fkey")

  @@index([employeId], map: "EmployeDocument_employeId_idx")
}

model employerole {
  employeId String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  employe   employe  @relation(fields: [employeId], references: [id], onDelete: Cascade, map: "EmployeRole_employeId_fkey")
  role      role     @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "EmployeRole_roleId_fkey")

  @@id([employeId, roleId])
  @@index([roleId], map: "EmployeRole_roleId_idx")
}

model evaluation {
  id                    String                @id @default(uuid())
  titre                 String
  date                  DateTime
  affectationId         String
  typeEvaluationId      String
  periodeScolaireId     String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now())
  affectationenseignant affectationenseignant @relation(fields: [affectationId], references: [id], onDelete: Cascade, map: "Evaluation_affectationId_fkey")
  periodescolaire       periodescolaire       @relation(fields: [periodeScolaireId], references: [id], onDelete: Cascade, map: "Evaluation_periodeScolaireId_fkey")
  typeevaluation        typeevaluation        @relation(fields: [typeEvaluationId], references: [id], onDelete: Cascade, map: "Evaluation_typeEvaluationId_fkey")
  note                  note[]

  @@index([affectationId], map: "Evaluation_affectationId_idx")
  @@index([periodeScolaireId], map: "Evaluation_periodeScolaireId_idx")
  @@index([typeEvaluationId], map: "Evaluation_typeEvaluationId_fkey")
}

model inscription {
  matricule                String?                @unique(map: "Inscription_matricule_key")
  dateInscription          DateTime               @default(now())
  type                     inscription_type
  apprenantId              String
  anneeScolaireId          String
  classeScolaireId         String
  configuartionScolariteId String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @default(now())
  absence                  absence[]
  bulletin                 bulletin[]
  decisionfinannee         decisionfinannee?
  dossierscolarite         dossierscolarite?
  anneescolaire            anneescolaire          @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade, map: "Inscription_anneeScolaireId_fkey")
  apprenant                apprenant              @relation(fields: [apprenantId], references: [id], onDelete: Cascade, map: "Inscription_apprenantId_fkey")
  classscolaire            classscolaire          @relation(fields: [classeScolaireId], references: [id], onDelete: Cascade, map: "Inscription_classeScolaireId_fkey")
  configurationscolarite   configurationscolarite @relation(fields: [configuartionScolariteId], references: [id], onDelete: Cascade, map: "Inscription_configuartionScolariteId_fkey")
  note                     note[]

  @@id([apprenantId, anneeScolaireId])
  @@unique([apprenantId, classeScolaireId], map: "Inscription_apprenantId_classeScolaireId_key")
  @@index([anneeScolaireId], map: "Inscription_anneeScolaireId_fkey")
  @@index([classeScolaireId, anneeScolaireId], map: "Inscription_classeScolaireId_anneeScolaireId_idx")
  @@index([configuartionScolariteId], map: "Inscription_configuartionScolariteId_fkey")
}

model lignebulletin {
  id                  String   @id @default(uuid())
  bulletinId          String
  bulletinApprenantId String
  bulletinAnneeId     String
  matiereId           String
  moyenne             Float
  coefficient         Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now())
  bulletin            bulletin @relation(fields: [bulletinApprenantId, bulletinAnneeId, bulletinId], references: [inscriptionApprenantId, inscriptionAnneeId, periodeScolaireId], onDelete: Cascade, map: "LigneBulletin_bulletinApprenantId_bulletinAnneeId_bulletinI_fkey")
  matiere             matiere  @relation(fields: [matiereId], references: [id], onDelete: Cascade, map: "LigneBulletin_matiereId_fkey")

  @@index([bulletinApprenantId, bulletinAnneeId, bulletinId], map: "LigneBulletin_bulletinApprenantId_bulletinAnneeId_bulletinI_fkey")
  @@index([matiereId], map: "LigneBulletin_matiereId_idx")
}

model matiere {
  id                    String                  @id @default(uuid())
  ecoleId               String
  nom                   String
  CodeMat               String
  description           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now())
  affectationenseignant affectationenseignant[]
  classematirere        classematirere[]
  lignebulletin         lignebulletin[]
  ecole                 ecole                   @relation(fields: [ecoleId], references: [id], onDelete: Cascade, map: "Matiere_ecoleId_fkey")
  matiereue             matiereue[]

  @@unique([nom, ecoleId], map: "Matiere_nom_ecoleId_key")
  @@index([ecoleId], map: "Matiere_ecoleId_idx")
}

model matiereue {
  uniteEnseignementId String
  matiereId           String
  coefficient         Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now())
  matiere             matiere           @relation(fields: [matiereId], references: [id], onDelete: Cascade, map: "MatiereUe_matiereId_fkey")
  uniteenseignement   uniteenseignement @relation(fields: [uniteEnseignementId], references: [id], onDelete: Cascade, map: "MatiereUe_uniteEnseignementId_fkey")

  @@id([uniteEnseignementId, matiereId])
  @@index([matiereId], map: "MatiereUe_matiereId_fkey")
}

model message {
  id             String       @id @default(uuid())
  contenu        String
  fichierUrl     String?
  dateEnvoi      DateTime     @default(now())
  lu             Boolean      @default(false)
  conversationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  conversation   conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, map: "Message_conversationId_fkey")

  @@index([conversationId, dateEnvoi], map: "Message_conversationId_dateEnvoi_idx")
  @@index([conversationId], map: "Message_conversationId_idx")
}

model niveauscolaire {
  id                     String                   @id @default(uuid())
  ecoleId                String
  nom                    String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now())
  classscolaire          classscolaire[]
  configurationscolarite configurationscolarite[]
  ecole                  ecole                    @relation(fields: [ecoleId], references: [id], onDelete: Cascade, map: "NiveauScolaire_ecoleId_fkey")

  @@unique([nom, ecoleId], map: "NiveauScolaire_nom_ecoleId_key")
  @@index([ecoleId], map: "NiveauScolaire_ecoleId_idx")
}

model note {
  id                      String                @id @default(uuid())
  Valeur                  Float
  Observation             String
  noteSur                 Int                   @default(20)
  inscriptionApprenantId  String
  inscriptionAnneeId      String
  affectationEnseignantId String
  typeEvaluationId        String
  periodeScolaireId       String
  evaluationId            String
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now())
  affectationenseignant   affectationenseignant @relation(fields: [affectationEnseignantId], references: [id], onDelete: Cascade, map: "Note_affectationEnseignantId_fkey")
  evaluation              evaluation            @relation(fields: [evaluationId], references: [id], onDelete: Cascade, map: "Note_evaluationId_fkey")
  inscription             inscription           @relation(fields: [inscriptionApprenantId, inscriptionAnneeId], references: [apprenantId, anneeScolaireId], onDelete: Cascade, map: "Note_inscriptionApprenantId_inscriptionAnneeId_fkey")
  periodescolaire         periodescolaire       @relation(fields: [periodeScolaireId], references: [id], onDelete: Cascade, map: "Note_periodeScolaireId_fkey")
  typeevaluation          typeevaluation        @relation(fields: [typeEvaluationId], references: [id], onDelete: Cascade, map: "Note_typeEvaluationId_fkey")

  @@index([affectationEnseignantId], map: "Note_affectationEnseignantId_idx")
  @@index([evaluationId], map: "Note_evaluationId_fkey")
  @@index([inscriptionApprenantId, inscriptionAnneeId], map: "Note_inscriptionApprenantId_inscriptionAnneeId_idx")
  @@index([periodeScolaireId], map: "Note_periodeScolaireId_idx")
  @@index([typeEvaluationId], map: "Note_typeEvaluationId_idx")
}

model paiement {
  id                 String                 @id @default(uuid())
  montant            Int
  datePaiement       DateTime
  moyenPaiement      paiement_moyenPaiement
  references         String?
  recuUrl            String?
  dossierScolariteId String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now())
  dossierscolarite   dossierscolarite       @relation(fields: [dossierScolariteId], references: [id], onDelete: Cascade, map: "Paiement_dossierScolariteId_fkey")

  @@index([dossierScolariteId], map: "Paiement_dossierScolariteId_idx")
}

model parent {
  id              String            @id @default(uuid())
  userId          String            @unique(map: "Parent_userId_key")
  profession      String
  createdAt       DateTime          @default(now())
  apprenantparent apprenantparent[]
  user            user              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Parent_userId_fkey")

  @@index([userId], map: "Parent_userId_idx")
}

model participantconversation {
  conversationId String
  userId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  conversation   conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, map: "ParticipantConversation_conversationId_fkey")
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ParticipantConversation_userId_fkey")

  @@id([conversationId, userId])
  @@index([userId], map: "ParticipantConversation_userId_idx")
}

model periodescolaire {
  id              String                 @id @default(uuid())
  annneScolaireId String
  nom             String
  ordre           Int
  dateDebut       DateTime
  dateFin         DateTime
  statut          periodescolaire_statut
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now())
  bulletin        bulletin[]
  evaluation      evaluation[]
  note            note[]
  anneescolaire   anneescolaire          @relation(fields: [annneScolaireId], references: [id], onDelete: Cascade, map: "PeriodeScolaire_annneScolaireId_fkey")

  @@index([annneScolaireId], map: "PeriodeScolaire_annneScolaireId_idx")
}

model permission {
  id             String            @id @default(uuid())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now())
  action         permission_action
  cible          permission_cible
  rolepermission rolepermission[]

  @@unique([action, cible], map: "Permission_action_cible_key")
}

model politiqueevaluation {
  id               String                             @id @default(uuid())
  ecoleId          String
  anneeScolaireId  String
  classeScolaireId String?                            @unique(map: "PolitiqueEvaluation_classeScolaireId_key")
  nom              String
  methodeCalcul    politiqueevaluation_methodeCalcul
  methodeArrondi   politiqueevaluation_methodeArrondi
  afficherRang     Boolean                            @default(true)
  estActive        Boolean                            @default(true)
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @default(now())
  anneescolaire    anneescolaire                      @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade, map: "PolitiqueEvaluation_anneeScolaireId_fkey")
  classscolaire    classscolaire?                     @relation(fields: [classeScolaireId], references: [id], onDelete: Cascade, map: "PolitiqueEvaluation_classeScolaireId_fkey")
  ecole            ecole                              @relation(fields: [ecoleId], references: [id], onDelete: Cascade, map: "PolitiqueEvaluation_ecoleId_fkey")
  regleevaluation  regleevaluation[]

  @@unique([nom, ecoleId], map: "PolitiqueEvaluation_nom_ecoleId_key")
  @@index([anneeScolaireId], map: "PolitiqueEvaluation_anneeScolaireId_idx")
  @@index([classeScolaireId], map: "PolitiqueEvaluation_classeScolaireId_idx")
  @@index([ecoleId], map: "PolitiqueEvaluation_ecoleId_idx")
}

model regleevaluation {
  id                  String              @id @default(uuid())
  nombreMin           Int                 @default(0)
  coefficientType     Int                 @default(1)
  politiqueId         String
  typeEvaluationId    String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now())
  politiqueevaluation politiqueevaluation @relation(fields: [politiqueId], references: [id], onDelete: Cascade, map: "RegleEvaluation_politiqueId_fkey")
  typeevaluation      typeevaluation      @relation(fields: [typeEvaluationId], references: [id], onDelete: Cascade, map: "RegleEvaluation_typeEvaluationId_fkey")

  @@unique([politiqueId, typeEvaluationId], map: "RegleEvaluation_politiqueId_typeEvaluationId_key")
  @@index([politiqueId], map: "RegleEvaluation_politiqueId_idx")
  @@index([typeEvaluationId], map: "RegleEvaluation_typeEvaluationId_idx")
}

model role {
  id             String           @id @default(uuid())
  nom            String
  description    String?
  estSystem      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now())
  ecoleId        String
  employerole    employerole[]
  ecole          ecole            @relation(fields: [ecoleId], references: [id], onDelete: Cascade, map: "Role_ecoleId_fkey")
  rolepermission rolepermission[]

  @@unique([nom, ecoleId], map: "Role_nom_ecoleId_key")
  @@index([ecoleId], map: "Role_ecoleId_fkey")
}

model rolepermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now())
  permission   permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "RolePermission_permissionId_fkey")
  role         role       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "RolePermission_roleId_fkey")

  @@id([roleId, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_idx")
}

model tranchescolarite {
  id                       String                 @id @default(uuid())
  nom                      String
  montant                  Int
  dateEcheance             DateTime
  ordre                    Int
  configurationScolariteId String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @default(now())
  configurationscolarite   configurationscolarite @relation(fields: [configurationScolariteId], references: [id], onDelete: Cascade, map: "TrancheScolarite_configurationScolariteId_fkey")

  @@index([configurationScolariteId], map: "TrancheScolarite_configurationScolariteId_idx")
}

model typeevaluation {
  id              String            @id @default(uuid())
  ecoleId         String
  nom             String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())
  evaluation      evaluation[]
  note            note[]
  regleevaluation regleevaluation[]
  ecole           ecole             @relation(fields: [ecoleId], references: [id], onDelete: Cascade, map: "TypeEvaluation_ecoleId_fkey")

  @@unique([ecoleId, nom], map: "TypeEvaluation_ecoleId_nom_key")
}

model uniteenseignement {
  id             String           @id
  nom            String
  code           String           @unique(map: "UniteEnseignement_code_key")
  coefficient    Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now())
  classematirere classematirere[]
  matiereue      matiereue[]
}

model user {
  id                      String                    @id @default(uuid())
  clerkUserId             String                    @unique(map: "User_clerkUserId_key")
  nom                     String
  prenoms                 String
  email                   String                    @unique(map: "User_email_key")
  telephone               String
  statut                  user_statut
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now())
  apprenant               apprenant?
  employe                 employe?
  parent                  parent?
  participantconversation participantconversation[]
  ecole                   ecole[]                   @relation("ecoletouser")
  ecolesCrees             ecole[]                   @relation("EcoleCreateur")
  demandes                demandeecole[]
}

view UserAuthorizationContext {
  userId          String                             @default("") @map("user_id")
  clerkUserId     String                             @default("") @map("clerk_user_id")
  typeUtilisateur String                             @default("") @map("type_utilisateur") @db.VarChar(9)
  ecoleId         String                             @default("") @map("ecole_id")
  action          user_authorization_context_action?
  cible           user_authorization_context_cible?
  apprenantId     String?                            @map("apprenant_id")

  @@unique([clerkUserId, ecoleId, action, cible, apprenantId])
  @@map("user_authorization_context")
}

