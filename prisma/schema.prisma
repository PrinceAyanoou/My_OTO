// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`



generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat    = "cjs"
 
}

datasource db {
  provider = "mysql"
}


model User {
    id              String                  @id @default(uuid())
    clerkUserId     String                  @unique
    nom             String
    prenoms         String
    email           String                  @unique
    telephone       String
    statut          UserStatut 


    ecole           Ecole[]

    parent          Parent[]
    apprenant       Apprenant?
    employe         Employe[]
    particpants     ParticipantConversation[]


    createdAt       DateTime                @default(now())
    updatedAt       DateTime                @default(now()) @updatedAt
}

enum UserStatut {
    ACTIF
    SUSPENDU
    DESACTIVE
    DOIT_MODIFIER_MDP
}



//défini un établissement dans sa globalité
model Ecole {
    id                          String                          @id @default(uuid())
    nom                         String
    type                        EcoleType
    nomFondateur                String
    ville                       String
    boitePostale                String?                         @unique
    email                       String                          @unique
    telephone                   String
    description                 String?
    statut                      EcoleStatut                     @default(EN_ATTENTE)
    code                        String                          @unique  //permettra de manipuler les écoles de manière unique sans invoquer la clé primaire de Ecole

    users                       User[]
    anneeScolaires              AnneeScolaire []
    niveauxScolaires            NiveauScolaire[]
    typeEvaluations             TypeEvaluation[]
    politiqueEvaluations        PolitiqueEvaluation[]
    matieres                    Matiere[]
    annonces                    Annonce[]
    conversations               Conversation[]
    configScolarite             ConfigurationScolarite []
    role                        Role[]

    @@index([ville])

    createdAt                   DateTime @default(now())
    valideAt                    DateTime  
    updatedAt                   DateTime @default(now()) @updatedAt

}

enum EcoleType {
    MATERNELLE_PRIMAIRE
    COLLEGE_LYCEE
    UNIVERSITE
}

enum EcoleStatut {
    EN_ATTENTE
    ACTIF
    SUSPENDU
    DESACTIVE
}



//Rôle Métier attribuable à un employé
model Role {
    id                      String                   @id @default(uuid())
    nom                     String
    description             String?
    estSystem               Boolean                  @default(false)
    ecoleId                 String

    employeRole             EmployeRole []
    rolePermission          RolePermission []
    ecole                   Ecole                    @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
    @@unique([nom, ecoleId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
}


//Association entre employé et rôle
model EmployeRole {
    employeId       String
    roleId          String

    employe         Employe     @relation(fields: [employeId], references: [id], onDelete: Cascade)
    role            Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@id([employeId, roleId])
    @@index([roleId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
}


//Permission du système
model Permission {
    id              String          @id @default(uuid())
    action          Action           
    cible           CibleAction

    rolePermission  RolePermission []
    @@unique([action, cible]) 

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
}


enum Action {
    READ
    CREATE 
    UPDATE
    DELETE
    MANAGE
}

enum CibleAction {
    absence
    affectationEnseignant
    anneeScolaire
    annonce
    apprenant
    apprenantParent
    bulletin
    cibleAnnoce
    classeMatiere
    classeScolaire
    configScolarite
    conversation
    decisionFinAnnee
    dossierScolarite
    ecole
    emploiDuTemps
    employe
    employeDocument
    employeRole
    evaluation
    inscription
    ligneBulletin
    matiere
    matiereUe
    message
    niveauScolaire
    note
    paiement
    parent
    participantConversation
    periodeScolaire
    politiqueEvaluation
    regleEvaluation 
    role
    rolePermission
    trancheScolarite
    typeEvaluation
    uniteEnseignement
    user
    all
}


//associationn entre rôle et permission : un rôle peut posséder plusieurs permissions et une permission peut appartenir à plusieurs rôles. 
//Pourquoi ne pas directement faire une association N:N entre rôle et permission
//C'est pour plus tard ajouter des attributs pour traquer qui donne les permissions 
//et aussi faire des logs beaucoup plus précis.
model RolePermission {
    roleId          String
    permissionId    String

    role            Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
    permission      Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

    @@id([roleId, permissionId])
    @@index([permissionId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
}


//définit les employés d'un établissement. prof, admin et autres
model Employe {
    id                          String                              @id @default(uuid())
    matricule                   String                              @unique
    dateEmbauche                DateTime
    clerkUserId                 String                              @unique


    employeDocument             EmployeDocument []
    employeRole                 EmployeRole []
    affectationEnseignant       AffectationEnseignant []
    annonces                    Annonce[]

    user                        User                                @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Cascade)
    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt

}


//documents associés à un employés, voir DocumentType pour détails
model EmployeDocument {
    id              String          @id @default(uuid())
    employeId       String
    type            DocumentType
    titre           String
    documentUrl     String

    employe         Employe         @relation(fields: [employeId], references: [id], onDelete: Cascade)

    @@index([employeId])

    createdAt       DateTime        @default(now())

}

enum DocumentType {
    DIPLOME
    CONTRAT
    PIECE_IDENTITE
    JUSTIFICATIF
}



//définit un parent. Il peut avoir plusieurs élèves
model Parent {
    id              String                  @id @default(uuid())
    userId          String                  @unique
    profession      String

    user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
    apprenantParent ApprenantParent[]

    createdAt       DateTime                @default(now())

    @@index([userId])
}


//définit un apprenant
//ecoleId a été enlevé volontairement car on peut déjà la trouver dans inscription
//les relations entre un apprenant et son école dépendent surtout de l'inscription 
//et non de l'entité apprenant.
model Apprenant {
    id              String                  @id @default(uuid())
    userId          String?                 @unique                
    matricule       String                  @unique
    nom             String
    prenoms         String
    Sexe            Sexe
    dateNaissance   DateTime
    
    user            User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
    parents         ApprenantParent[]
    inscriptions    Inscription[]           // un apprenant a plusieurs inscriptions dans le temps. 
                                            //Cette relation ne sert pas à prouver l'unicité de l'inscription d'un apprenant dans une école au cours d'une année scolaire        
    
    createdAt       DateTime                @default(now())
    updatedAt       DateTime                @default(now()) @updatedAt

    @@index([userId])
    @@index([matricule])

   
}

enum Sexe {
    MASCULIN
    FEMININ
}


//liason entre apprenant et parent (plusieurs parents possibles)
model ApprenantParent {
    apprenantId     String
    parentId        String
    lien            lienParente 

    parent          Parent      @relation(fields: [parentId], references: [id],onDelete: Cascade)
    apprenant       Apprenant   @relation(fields: [apprenantId], references: [id], onDelete: Cascade)

    @@id([apprenantId, parentId])
    @@index([parentId])
}

enum lienParente {
    PERE
    MERE
    TUTEUR
}




//Annee Scolaire
model AnneeScolaire {
    id              String              @id @default(uuid())
    ecoleId         String
    nom             String              //ex "2026-2027", faire les validations en dto
    dateDebut       DateTime
    dateFin         DateTime
    statut          AnneeStatut         @default(EN_PREPARATION)

    ecole           Ecole               @relation(fields: [ecoleId],references: [id])
    inscription     Inscription[]
    periodeScolaire PeriodeScolaire []
    affectation     AffectationEnseignant []
    politiqueEval   PolitiqueEvaluation []
    configScolarite ConfigurationScolarite []

    @@unique([nom, ecoleId])            //Pas deux fois la même année Scolaire dans la même écoele
    @@index([ecoleId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt

}

enum AnneeStatut {
    EN_COURS
    EN_PREPARATION
    TERMINEE
    ARCHIVEE 
}



//Période (trimestre ou semestre) d'une année Scolaire
model PeriodeScolaire {
    id              String      @id @default(uuid())
    annneScolaireId String      
    nom             String      //1er Trimestres ...
    ordre           Int         //important pour savoir qu'est-ce qui vient avant et après
    dateDebut       DateTime
    dateFin         DateTime
    statut          PeriodeStatut

    anneeScolaire   AnneeScolaire @relation(fields: [annneScolaireId], references: [id], onDelete: Cascade)
    bulletin        Bulletin []
    note            Note []
    evaluations     Evaluation[]

    @@index([annneScolaireId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt

}

enum PeriodeStatut {
    NON_COMMENCEE
    OUVERTE
    CLOTUREE
    ARCHIVEE
}



//Niveau scolaire = Classe (ex: Terminale, 1er Année, Marternelle 1 ...)
model NiveauScolaire { 
    id              String              @id @default(uuid())
    ecoleId         String
    nom             String

    ecole           Ecole               @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
    classeScolaire  ClassScolaire []
    configScolarite ConfigurationScolarite []
    createdAt       DateTime            @default(now())

    @@unique([nom, ecoleId])
    @@index([ecoleId])

    updatedAt                   DateTime                            @default(now()) @updatedAt
}



model ClassScolaire {
    id                          String          @id @default(uuid())
    niveauScolaireId            String 
    nom                         String          //ClasseScolaire = Salle (ex: Terminale C, 1er Année Groupe 2, Maternelle 1-A)
    capacite                    Int
    emploiDuTempsId             String          @unique

    niveauScolaire              NiveauScolaire   @relation(fields: [niveauScolaireId], references: [id], onDelete: Cascade)
    inscription                 Inscription []
    affectationEnseignant       AffectationEnseignant []
    emploiDuTemps               EmploiDuTemps   @relation(fields: [emploiDuTempsId], references: [id], onDelete: Cascade)   
    classeMatiere               ClasseMatirere []
    PolitiqueEval               PolitiqueEvaluation?

    createdAt                   DateTime         @default(now())
    updatedAt                   DateTime         @default(now()) @updatedAt

    @@unique([niveauScolaireId, nom])  //pas deux classe avec le même nom dans un niveau
    @@index([niveauScolaireId])
}



//les matières
model Matiere {
    id                          String                          @id @default(uuid())
    ecoleId                     String
    nom                         String
    CodeMat                     String                          //ex: Fr pour Français, MATHS pour Mathématiques
    description                 String?                         //décrire un peu en quoi consiste la matière

    ecole                       Ecole                           @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
    affectationEnseignant       AffectationEnseignant []
    matiereUe                   MatiereUe[]
    classeMatiere               ClasseMatirere []
    ligneBulletin               LigneBulletin []


    @@unique([nom, ecoleId])
    @@index([ecoleId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
}


//defini les UE
model UniteEnseignement {
    id                  String          @id @default(uuid())
    nom                 String          // nom de l'UE
    code                String          @unique
    coefficient         Int             //Coeffiecient total de l'ue
    matiereUe           MatiereUe []
    claseMatiere        ClasseMatirere []

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
}



//laison de matirer dans une Ue
model MatiereUe {
    uniteEnseignementId String
    matiereId           String
    coefficient         Int                 //coefficient de la matiere dans l'UE

    ue                  UniteEnseignement   @relation(fields: [uniteEnseignementId], references: [id], onDelete: Cascade)
    matiere             Matiere             @relation(fields: [matiereId], references: [id], onDelete: Cascade)

    @@id([uniteEnseignementId, matiereId]) 

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
}



//laison Classe Matiere (Fr en Terminale A)
model ClasseMatirere {
    id                  String              @id @default(uuid())
    classeScolaireId    String
    matiereId           String
    uniteEnseignementId String?
    coefficient         Int

    classeScolaire      ClassScolaire       @relation(fields: [classeScolaireId], references: [id], onDelete: Cascade)
    matiere             Matiere             @relation(fields: [matiereId], references: [id], onDelete: Cascade)
    uniteEnseignement   UniteEnseignement?   @relation(fields: [uniteEnseignementId], references: [id])

    @@unique([classeScolaireId,matiereId])
    @@index([classeScolaireId])

    createdAt           DateTime            @default(now())
    updatedAt           DateTime            @default(now()) @updatedAt
}



//Affectation d'un enseignant à une classe pour une matière et année
model AffectationEnseignant {
    id                  String          @id @default(uuid())
    employeId           String
    classeScolaireId    String
    matiereId           String
    anneeScolaireId     String

    employe             Employe         @relation(fields: [employeId], references: [id], onDelete: Cascade)
    classeScolaire      ClassScolaire   @relation(fields: [classeScolaireId], references: [id], onDelete: Cascade)
    matiere             Matiere         @relation(fields: [matiereId], references: [id], onDelete: Cascade)
    anneeScolaire       AnneeScolaire   @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
    cours               EmploiDuTemps[]
    evaluations         Evaluation[]
    note                Note []
    absences            Absence []

    @@unique([matiereId, classeScolaireId, anneeScolaireId]) //Une matière par classe par annee a 1 seul enseignant
    @@index([employeId])
    @@index([anneeScolaireId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt

}



// Emploi du temps (créneaux) pour une affectation
model EmploiDuTemps {
    id                          String                   @id @default(uuid())
    affectationEnseignantId     String  
    jourDeLaSemaine             JourSemaine
    heureDebut                  String                  //fera la validation en dto
    heureFin                    String
    classeScolaireId            String

    affectationEnseignant       AffectationEnseignant   @relation(fields: [affectationEnseignantId], references: [id],onDelete:Cascade )
    classeScolaire              ClassScolaire?           
    

    @@unique([affectationEnseignantId, jourDeLaSemaine, heureDebut])

    createdAt                   DateTime                @default(now())
    updatedAt                   DateTime                @default(now()) @updatedAt
}

enum JourSemaine {
    LUNDI
    MARDI
    MERCREDI
    JEUDI
    VENDREDI
    SAMEDI
    DIMANCHE
}



// Type d’évaluation (catégorie), défini par l’école
model TypeEvaluation {
    id                          String                  @id @default(uuid())
    ecoleId                     String
    nom                         String                  //ex: Interro 1

    ecole                       Ecole                   @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
    evaluations                 Evaluation[]
    regleEval                   RegleEvaluation []
    notes                       Note []
    @@unique([ecoleId, nom])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
}


// Politique de calcul des notes pour une classe/année
model PolitiqueEvaluation {
    id                          String                  @id @default(uuid())
    ecoleId                     String
    anneeScolaireId             String
    classeScolaireId            String?                 @unique
    nom                         String                  //servira à identifier sur l'interface la politique d'évaluation. C'est surtout pratique quand une école en a plusieurs
    methodeCalcul               MethodeCalcul           // permet de savoir si on doit faire avec ou sans coefficient et si oui, le coefficient est appliqué ou? matière ou notes
    methodeArrondi              MethodeArrondi          //permet de savoir si on veut 15 ou 15.68 ou le réel
    afficherRang                Boolean                 @default(true)
    estActive                   Boolean                 @default(true)  //une école peut avoir plusieurs politiques mais n'en utiliser qu'une seule

    ecole                       Ecole                   @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
    anneeScolaire               AnneeScolaire           @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
    classeScolaire              ClassScolaire?          @relation(fields: [classeScolaireId], references: [id], onDelete: Cascade)
    regles                      RegleEvaluation[]       // Détails (nb d'épreuves et coef par type)
    @@unique([nom, ecoleId])
    @@index([ecoleId])
    @@index([anneeScolaireId])
    @@index([classeScolaireId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt

}


// Règle d'évaluation dans une politique (nb min d’épreuves et coefficient)
model RegleEvaluation {
  id                   String             @id @default(uuid())
  nombreMin            Int                @default(0)  // Nb minimum d'épreuves
  coefficientType      Int                @default(1)  // Coefficient appliqué à ce type (si moyenne pondérée)
  
  politiqueId          String
  typeEvaluationId     String

  politique            PolitiqueEvaluation @relation(fields: [politiqueId], references: [id], onDelete: Cascade) 
  typeEvaluation       TypeEvaluation     @relation(fields: [typeEvaluationId], references: [id], onDelete: Cascade)
  

  @@unique([politiqueId, typeEvaluationId])
  @@index([politiqueId])
  @@index([typeEvaluationId])

  createdAt                   DateTime                            @default(now())
  updatedAt                   DateTime                            @default(now()) @updatedAt

}




/// Évaluation (devoir, interro, contrôle), créée par un enseignant pour une classe
model Evaluation {
  id                      String   @id @default(uuid())
  titre                   String   //Devoir 1 Maths"
  date                    DateTime
  
  affectationId           String
  typeEvaluationId        String
  periodeScolaireId       String

  affectation             AffectationEnseignant  @relation(fields: [affectationId], references: [id], onDelete: Cascade)
  typeEvaluation          TypeEvaluation         @relation(fields: [typeEvaluationId], references: [id], onDelete: Cascade)
  periodeScolaire         PeriodeScolaire       @relation(fields: [periodeScolaireId], references: [id], onDelete: Cascade)

  notes                   Note[] // Toutes les notes des élèves pour cette évaluation

  @@index([affectationId])
  @@index([periodeScolaireId])

  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt
}

enum MethodeCalcul {
    MOYENNE_SIMPLE
    MOYENNE_PONDEREE
}

enum MethodeArrondi {
    AUCUN
    ENTIER
    DIXIEME
    CENTIEME
}



//Note obtenue par un élève à une évaluation
model Note {
    id                          String                  @id @default(uuid())
    Valeur                      Float
    Observation                 String                  //le prof peut laisser une observation sur la note que le parent verra
    noteSur                     Int                     @default(20)
    
    inscriptionApprenantId      String
    inscriptionAnneeId          String
    affectationEnseignantId     String  
    typeEvaluationId            String
    periodeScolaireId           String
    evaluationId                String

    inscription                 Inscription             @relation(fields: [inscriptionApprenantId, inscriptionAnneeId], references: [apprenantId,anneeScolaireId], onDelete: Cascade)
    affectation                 AffectationEnseignant   @relation(fields: [affectationEnseignantId], references: [id], onDelete: Cascade)
    typeEvaluation              TypeEvaluation          @relation(fields: [typeEvaluationId], references: [id], onDelete: Cascade)
    periodeScolaire             PeriodeScolaire         @relation(fields: [periodeScolaireId], references: [id], onDelete: Cascade)
    evaluation                  Evaluation              @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

    @@index([inscriptionApprenantId, inscriptionAnneeId])
    @@index([affectationEnseignantId])
    @@index([typeEvaluationId])
    @@index([periodeScolaireId])

   
    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt

    
    
}



//inscription d'un apprenant dans une école, année, classe.
model Inscription {
    matricule                   String?                 @unique
    dateInscription             DateTime                @default(now())
    type                        InscriptionType     

    apprenantId                 String
    anneeScolaireId             String
    classeScolaireId            String
    configuartionScolariteId    String                  //frais de scolarité de l'apprenant
   

    apprenant                   Apprenant               @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
    anneeScolaire               AnneeScolaire           @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
    classeScolaire              ClassScolaire           @relation(fields: [classeScolaireId], references: [id], onDelete: Cascade)
    configurationScolarite      ConfigurationScolarite  @relation(fields: [configuartionScolariteId], references: [id], onDelete: Cascade)
    dossierScolarite            DossierScolarite?
    decisionFinale              DecisionFinAnnee?
    
    bulletins                    Bulletin[]              //plusieurs bulletins mais un par période
    notes                        Note[]                  //Note d'un apprenant. Notons qu'une note n'est reliée à un bulletin que si l'admin lance la génération
    absences                     Absence []

    @@id([apprenantId,anneeScolaireId])
    @@unique([apprenantId, classeScolaireId])
    @@index([classeScolaireId, anneeScolaireId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
    
    
}

enum InscriptionType {
    INSCRIPTION 
    REINSCRIPTION
    TRANSFERT_EN_COURS_D_ANNEE
}



//bulletin scolaire par apprenant et par période scolaire
model Bulletin {
   
    moyenneGenerale             Float 
    documentUrl                 String
    Rang                        Int?                    //classement par classe
    estGenere                   Boolean                 @default(false)
    dateGeneration              DateTime?
    appreciation                String?
    decisionFinAnnee            DecisionFinAnneeType

    inscriptionApprenantId      String
    inscriptionAnneeId          String
    periodeScolaireId           String  

    inscription                 Inscription             @relation(fields: [inscriptionApprenantId, inscriptionAnneeId], references: [apprenantId,anneeScolaireId], onDelete: Cascade)
    periodeScolaire             PeriodeScolaire         @relation(fields: [periodeScolaireId], references: [id], onDelete: Cascade)
    lignes                      LigneBulletin[]

    @@id([inscriptionApprenantId, inscriptionAnneeId ,periodeScolaireId])
    @@index([periodeScolaireId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
    
}




// Détail par matière sur le bulletin (moyenne et coef)
model LigneBulletin {
  id                            String                  @id @default(uuid())
  bulletinId                    String
  bulletinApprenantId           String
  bulletinAnneeId               String
  matiereId                     String
  moyenne                       Float
  coefficient                   Int

  bulletin                      Bulletin                @relation(fields: [bulletinApprenantId, bulletinAnneeId, bulletinId], references: [inscriptionApprenantId, inscriptionAnneeId, periodeScolaireId], onDelete: Cascade)
  matiere                       Matiere                 @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  createdAt                   DateTime                            @default(now())
  updatedAt                   DateTime                            @default(now()) @updatedAt

  @@index([matiereId])
}




//Absence pour un apprenant
model Absence {
    id                          String                  @id @default(uuid())
    dateDebut                   DateTime
    dateFin                     DateTime
    motif                       String
    statut                      AbsenceStatut
    commentaire                 String?
    declareParUserId            String                  //celui qui déclare l'absence
    justificatifUrl             String?   

    inscriptionApprenantId      String  
    inscriptionAnneeId          String
    affectationEnseignantId     String?

    inscription                 Inscription             @relation(fields: [inscriptionApprenantId, inscriptionAnneeId], references: [apprenantId,anneeScolaireId], onDelete: Cascade)
    affectationEnseignant       AffectationEnseignant?  @relation(fields: [affectationEnseignantId], references: [id], onDelete: Cascade)

    @@index([inscriptionApprenantId, inscriptionAnneeId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
    
}

enum AbsenceStatut {
    JUSTIFIEE
    NON_JUSTIFIEE
}




//
model ConfigurationScolarite {
    id                          String                  @id @default(uuid())
    nom                         String                  //ex: Scolarité Terminale 2026
    estActive                   Boolean                 @default(true)

    ecoleId                     String
    niveauScolaireId            String
    anneeScolaireId             String

    ecole                       Ecole                   @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
    niveauScolaire              NiveauScolaire          @relation(fields: [niveauScolaireId], references: [id], onDelete: Cascade)
    anneeScolaire               AnneeScolaire           @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
    inscription                 Inscription []
    tranches                    TrancheScolarite []
    dossierScolarite            DossierScolarite[]

    @@unique([niveauScolaireId, anneeScolaireId])       //une seule config par niveau scolaire et non par classe

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
    
}



// Tranche de paiement liée à une configuration de scolarité
model TrancheScolarite {
    id                          String                  @id @default(uuid())
    nom                         String
    montant                     Int
    dateEcheance                DateTime
    ordre                       Int

    configurationScolariteId    String

    configurationScolarite      ConfigurationScolarite  @relation(fields: [configurationScolariteId], references: [id], onDelete: Cascade)

    @@index([configurationScolariteId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt

    //ex: 1ere tranche :100.000 fcfa avant le 30/10/2027
}




// Dossier de scolarité (suivi des paiements) pour une inscription
model DossierScolarite {
    id                          String                  @id @default(uuid())
    montant                     Int
    resteAPayer                 Int
    statut                      DossierScolariteStatut

    inscriptionApprenantId      String
    inscriptionAnneeId          String
    configurationScolariteId    String

    inscription                 Inscription             @relation(fields: [inscriptionApprenantId, inscriptionAnneeId], references: [apprenantId,anneeScolaireId], onDelete: Cascade)
    configurationScolarite      ConfigurationScolarite  @relation(fields: [configurationScolariteId], references: [id], onDelete: Cascade)
    paiements                   Paiement[]

    @@index([inscriptionApprenantId, inscriptionAnneeId])
    @@unique([inscriptionApprenantId, inscriptionAnneeId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
}

enum DossierScolariteStatut {
    A_JOUR
    EN_RETARD
    SOLDEE
}




//Paiement effectué sur un dossier de scolarité
model Paiement {
    id                          String                  @id @default(uuid())
    montant                     Int
    datePaiement                DateTime
    moyenPaiement               MoyenPaiement
    references                  String?
    recuUrl                     String?

    dossierScolariteId          String

    dossierScolarite            DossierScolarite        @relation(fields: [dossierScolariteId], references: [id], onDelete: Cascade)

    @@index([dossierScolariteId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
    
}

enum MoyenPaiement {
    BANQUE
    MOBILE_MONEY
    ESPECES
}




//Annonce diffusée (privée ou publique)
model Annonce {
    id                          String                  @id @default(uuid())
    titre                       String              
    contenu                     String
    datePubication              DateTime                @default(now())
    dateExpiration              DateTime

    ecoleId                     String
    auteurId                    String

    ecole                       Ecole                   @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
    employe                     Employe                 @relation(fields: [auteurId], references: [id], onDelete: Cascade)
    cibleAnnoce                 CibleAnnonce[]

    @@index([ecoleId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
    
}

model CibleAnnonce {
    id                          String                  @id @default(uuid())  
    public                      PublicAnnonce

    annonceId                   String
    classeScolaireId            String?

    annonce                     Annonce                 @relation(fields: [annonceId], references: [id], onDelete: Cascade)

    @@index([annonceId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt


}

enum PublicAnnonce {
    TOUS
    EMPLOYE
    PARENT
    APPRENANT
}



//Conversation pour échanges de messages
model Conversation {
    id                          String                      @id @default(uuid())
    type                        ConversationType        
    
    ecoleId                     String

    ecole                       Ecole                       @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
    particpants                 ParticipantConversation[]
    messages                    Message[]

    @@index([ecoleId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
    
}

enum ConversationType {
    PRIVEE
    GROUPE
}


// Participant d'une conversation (user ↔ conversation)
model ParticipantConversation {
    conversationId              String                  
    userId                      String

    conversation                Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    user                        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])

    @@id([conversationId,userId ])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
    
}




// Message dans une conversation
model Message {
    id                          String                  @id @default(uuid())
    contenu                     String
    fichierUrl                  String?
    dateEnvoi                   DateTime                @default(now())
    lu                          Boolean                 @default(false)

    conversationId              String          

    conversation                Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@index([conversationId])
    @@index([conversationId, dateEnvoi])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
    
}




// Décision de fin d'année pour un apprenant
model DecisionFinAnnee {
    id                          String                  @id @default(uuid())
    decision                    DecisionFinAnneeType    

    inscriptionApprenantId      String
    inscriptionAnneeId          String

    incscription                Inscription             @relation(fields: [inscriptionApprenantId, inscriptionAnneeId], references: [apprenantId,anneeScolaireId], onDelete: Cascade)

    @@unique([inscriptionApprenantId, inscriptionAnneeId])

    createdAt                   DateTime                            @default(now())
    updatedAt                   DateTime                            @default(now()) @updatedAt
    
}

enum DecisionFinAnneeType {
    ADMIS
    REDOUBLE
    EXCLU
    TRANSFERE
}


